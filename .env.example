# Evolution API public server
SERVER_TYPE=http
SERVER_PORT=8080
SERVER_URL=https://YOUR-RENDER-SERVICE.onrender.com

# Protect the Evolution API. Set the real value only in Render.
AUTHENTICATION_API_KEY=CHANGE_ME_IN_RENDER
AUTHENTICATION_EXPOSE_IN_FETCH_INSTANCES=false

# PostgreSQL (set the real connection string in Render)
DATABASE_ENABLED=true
DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_URI=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_CONNECTION_CLIENT_NAME=athoo_evolution
DATABASE_SAVE_DATA_INSTANCE=true
DATABASE_SAVE_DATA_NEW_MESSAGE=true
DATABASE_SAVE_MESSAGE_UPDATE=true
DATABASE_SAVE_DATA_CONTACTS=true
DATABASE_SAVE_DATA_CHATS=true
DATABASE_SAVE_DATA_LABELS=true
DATABASE_SAVE_DATA_HISTORIC=true

# Redis (set the real URL in Render)
CACHE_REDIS_ENABLED=true
CACHE_REDIS_URI=redis://default:PASSWORD@HOST:6379
CACHE_REDIS_PREFIX_KEY=athoo-evolution
CACHE_REDIS_SAVE_INSTANCES=true
CACHE_LOCAL_ENABLED=false

# Keep telemetry/logging conservative
TELEMETRY=false
LOG_LEVEL=ERROR,WARN,INFO
LOG_BAILEYS=error

# Athoo will call Evolution from the backend only.
# Never commit real API keys, database passwords, Redis passwords, or OTP secrets.
